{
  "name": "dsh-live-teams",
  "version": "0.3.0",
  "type": "module",
  "description": "A team of long-lived DSH Sessions with durable tasks, review and acceptance.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "roles/**/*.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.2": "untested",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client && pnpm run build:client:types",
    "build:host": "tsdown --config tsdown.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build:client:types": "tsc -p tsconfig.client.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@types/node": "22.20.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.5",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "multi-agent",
    "team",
    "coordination",
    "tasks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gdenich/dsh-live-teams.git"
  },
  "homepage": "https://github.com/Gdenich/dsh-live-teams#readme",
  "bugs": {
    "url": "https://github.com/Gdenich/dsh-live-teams/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Gdenich"
}
